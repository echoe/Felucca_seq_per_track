diff --git a/firmware/src/patbank.c b/firmware/src/patbank.c
new file mode 100644
index 0000000..c09837b
--- /dev/null
+++ b/firmware/src/patbank.c
@@ -0,0 +1,353 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments */
+/* Sequences: eight per track (FELUCCA_PATBANK). A track plays one of them at a time: trk[].step is the one playing, the
+ * other seven live in a RAM mirror (pb_pat, packed as a project packs steps: 9 bytes). Each sequence has its own steps, its
+ * own LEN (P_SLEN) and its own automation (the track's motion records, at most PB_MO_MAX = 64 of them while it is not the
+ * one playing). DIV, SWING, GATE, QUANTIZE and the sound stay the track's.
+ * Switching (pb_select): the playing sequence is packed into the mirror, the chosen one is put into the track, at once,
+ * in the middle of a pass (the playhead keeps its step). Main loop only.
+ * Persistence (patbank_store.c): the project record keeps the sequence that plays; the others are in flash, five stores
+ * (project A..D, the live music) of six objects: object o < 5 holds sequences 6 o .. 6 o + 5 (q = track * 8 + slot), object
+ * 5 the last two and the rest (the sequence each track plays, the LENs, the automation of the sequences not playing). */
+#if FELUCCA_PATBANK
+#define PB_N 8u                          /* sequences per track */
+#define PB_NSEQ (NTRK * PB_N)
+#define PB_STEP_B 9u                     /* a step packed: project.c proj_pack's nine bytes */
+#define PB_PAT_B (NSTEP * PB_STEP_B)
+#define PB_MO_MAX 64u                    /* automation records of a sequence that is not playing */
+#define PB_PER 6u                        /* sequences an object holds */
+#define PB_NOBJ 6u
+#define PB_NSTORE 5u
+#define PB_LIVE 4u                       /* the live music's store */
+#define PB_HDR 8u
+#define PB_META_O 5u
+#define PB_OBJ_MAX ST_PAYLOAD_MAX
+typedef struct { uint8_t count, on; motion_event_t ev[PB_MO_MAX]; } pb_mo_t;
+
+static uint8_t pb_cur[NTRK];             /* the sequence each track plays, 0..7 */
+static uint8_t pb_len[PB_NSEQ];          /* LEN of each (the playing one's is the track's P_SLEN) */
+static uint8_t pb_pat[PB_NSEQ][PB_PAT_B] __attribute__((section(".pool")));
+static pb_mo_t pb_mo[PB_NSEQ] __attribute__((section(".pool")));   /* (the playing sequence's: motion) */
+static uint8_t pb_next[NTRK];            /* a switch waiting for the end of the sequence playing: the slot + 1, 0 none (SEQ SWITCH END) */
+static uint8_t pb_last[NTRK];            /* the step each track was on when pb_due last looked */
+static uint8_t pb_fired[NTRK];           /* a switch happened on this pass's last step: not again until the pass is under way */
+static uint8_t pb_cmask[NTRK];           /* CHAIN: bit s set, sequence s of the track is one the user chained (patbank.c pb_chain_next) */
+static uint8_t pb_ready;
+static uint8_t pb_dirty;                 /* bit o: the live store's object o is older than the mirror */
+static uint32_t pb_gen;                  /* + 1 per change (autosave_sig) */
+
+/* ---- steps <-> bytes: the bytes of project.c proj_pack / proj_unpack ---- */
+static void pb_pack_step(uint8_t *b, const step_t *s)
+{
+    uint32_t r = step_ratchet(s) - 1u, nd = (uint32_t)step_nudge(s) & 15u, j;
+    uint32_t n = s->n > 4u ? 4u : s->n, tm = s->time > ST_REST ? ST_REST : s->time;
+    for (j = 0; j < 4u; j++)
+        b[j] = (uint8_t)((s->note[j] > 127u ? 127u : s->note[j]) | (nd >> j & 1u) << 7);
+    b[4] = (uint8_t)(n | tm << 3 | (s->flags & 3u) << 5);
+    b[5] = (uint8_t)((s->vel > 127u ? 127u : s->vel) | (r & 1u) << 7);
+    b[6] = s->hit;
+    b[7] = s->acc & s->hit;
+    b[8] = (uint8_t)((s->probability >= COND_FIRST + NCOND ? 101u : s->probability) | (r >> 1) << 7);   /* (1.5.5: 102.. a condition) */
+}
+static int pb_unpack_step(step_t *s, const uint8_t *b)
+{
+    uint32_t meta = b[4], nd = 0, j;
+    for (j = 0; j < 4u; j++) {
+        nd |= (uint32_t)(b[j] >> 7) << j;
+        s->note[j] = b[j] & 127u;
+    }
+    s->n = meta & 7u;
+    s->time = (meta >> 3) & 3u;
+    s->flags = (meta >> 5) & 3u;
+    s->vel = b[5] & 127u;
+    meta |= (uint32_t)(b[5] & 128u) << 1;
+    s->hit = b[6];
+    s->acc = b[7];
+    s->probability = b[8] & 127u;
+    meta |= (uint32_t)(b[8] & 128u) << 2;
+    if ((meta & 255u) > 127u || s->n > 4u || s->time > ST_REST || s->probability >= COND_FIRST + NCOND || (s->acc & ~s->hit))
+        return 0;
+    step_set_ratchet(s, (meta >> 8) + 1u);
+    step_set_nudge(s, (int32_t)(nd ^ 8u) - 8);
+    return 1;
+}
+static void pb_pack_pat(uint8_t *d, const step_t *st)
+{
+    uint32_t i;
+    for (i = 0; i < NSTEP; i++)
+        pb_pack_step(d + i * PB_STEP_B, &st[i]);
+}
+static int pb_unpack_pat(step_t *st, const uint8_t *d)   /* 0: a step is no step: every one empty */
+{
+    uint32_t i;
+    for (i = 0; i < NSTEP; i++)
+        if (!pb_unpack_step(&st[i], d + i * PB_STEP_B)) {
+            for (i = 0; i < NSTEP; i++)
+                step_clear(&st[i]);
+            return 0;
+        }
+    return 1;
+}
+
+static void pb_clear_all(void)
+{
+    uint32_t q;
+    step_t e[NSTEP];
+    for (q = 0; q < NSTEP; q++)
+        step_clear(&e[q]);
+    pb_pack_pat(pb_pat[0], e);
+    for (q = 1; q < PB_NSEQ; q++)
+        memcpy(pb_pat[q], pb_pat[0], PB_PAT_B);
+    memset(pb_mo, 0, sizeof pb_mo);
+    memset(pb_cur, 0, sizeof pb_cur);
+    memset(pb_next, 0, sizeof pb_next);
+    memset(pb_cmask, 0, sizeof pb_cmask);
+    memset(pb_fired, 0, sizeof pb_fired);
+    memset(pb_last, 0, sizeof pb_last);
+    for (q = 0; q < PB_NSEQ; q++)
+        pb_len[q] = (uint8_t)TP[P_SLEN].def;
+    pb_ready = 1;
+}
+static void pb_need(void) { if (!pb_ready) pb_clear_all(); }
+
+/* the playing sequence of track t into the mirror (its steps, its LEN); marks the live store's objects that changed */
+static void pb_sync(uint32_t t)
+{
+    uint8_t b[PB_PAT_B];
+    uint32_t q;
+    pb_need();
+    q = t * PB_N + pb_cur[t];
+    pb_pack_pat(b, trk[t].step);
+    if (memcmp(pb_pat[q], b, PB_PAT_B)) {
+        memcpy(pb_pat[q], b, PB_PAT_B);
+        pb_dirty |= (uint8_t)(1u << (q / PB_PER));
+        pb_gen++;
+    }
+    if (pb_len[q] != (uint8_t)trk[t].p[P_SLEN]) {
+        pb_len[q] = (uint8_t)trk[t].p[P_SLEN];
+        pb_dirty |= 1u << PB_META_O;
+        pb_gen++;
+    }
+}
+static void pb_sync_all(void)
+{
+    uint32_t t;
+    for (t = 0; t < NTRK; t++)
+        pb_sync(t);
+}
+
+/* a sequence with a note or a hit in it (the playing one: the track's steps) */
+static int pb_filled(uint32_t t, uint32_t slot)
+{
+    uint32_t i;
+    pb_need();
+    if (slot == pb_cur[t])
+        return !seq_is_empty(&trk[t]);
+    for (i = 0; i < NSTEP; i++) {
+        const uint8_t *b = pb_pat[t * PB_N + slot] + i * PB_STEP_B;
+        if ((b[4] & 7u) || b[6])
+            return 1;
+    }
+    return 0;
+}
+
+/* track t plays sequence `slot`. 0 done; 1 no such; 2 the playing sequence has more than PB_MO_MAX automation records
+ * (it could not be kept); 3 the automation of the sequence does not fit with the other tracks' */
+static int pb_select(uint32_t t, uint32_t slot)
+{
+    track_t *tr;
+    motion_store_t mo, in;
+    step_t ns[NSTEP];
+    uint32_t q, old, i, f;
+    if (t >= NTRK || slot >= PB_N)
+        return 1;
+    pb_need();
+    if (slot == pb_cur[t])
+        return 0;
+    tr = &trk[t];
+    motion_snapshot_track(tr, &mo);
+    if (mo.count > PB_MO_MAX)
+        return 2;
+    q = t * PB_N + slot;
+    old = t * PB_N + pb_cur[t];
+    memset(&in, 0, sizeof in);
+    in.count = pb_mo[q].count;
+    in.on = pb_mo[q].on ? (uint8_t)(1u << t) : 0u;
+    for (i = 0; i < in.count && i < PB_MO_MAX; i++)
+        in.event[i] = pb_mo[q].ev[i];
+    if (in.count > PB_MO_MAX || !motion_valid(&in))
+        memset(&in, 0, sizeof in);
+    for (i = 0; i < in.count; i++)
+        if ((in.event[i].place >> 6) != t)
+            memset(&in, 0, sizeof in);
+    pb_sync(t);
+    (void)pb_unpack_pat(ns, pb_pat[q]);
+    if (motion_replace_track(tr, &in))
+        return 3;
+    pb_mo[old].count = mo.count;
+    pb_mo[old].on = (uint8_t)(mo.on != 0u);
+    for (i = 0; i < mo.count; i++)
+        pb_mo[old].ev[i] = mo.event[i];
+    pb_mo[q].count = 0;
+    f = motion_guard();
+    memcpy(tr->step, ns, sizeof ns);
+    tr->p[P_SLEN] = (int16_t)clamp((int32_t)pb_len[q], TP[P_SLEN].min, TP[P_SLEN].max);
+    tr->rh_n = tr->rskip_n = 0;
+    motion_unguard(f);
+    pb_cur[t] = (uint8_t)slot;
+    pb_next[t] = 0;
+    pb_dirty |= (uint8_t)(1u << (q / PB_PER) | 1u << (old / PB_PER) | 1u << PB_META_O);
+    pb_gen++;
+    return 0;
+}
+
+/* CHAIN: the sequences the user chained (pb_cmask, PRESETS on SEQ > SEQUENCE) of a track play one after the other, in
+ * order, the last back to the first, a sequence at the end of each pass of the one playing. Only those: a sequence not chained
+ * plays by itself, looping, and so does the only one chained. Whole sequences of 1..64 steps each: 8 x 64 steps at most */
+static uint32_t pb_chain_count(uint32_t t)             /* how many sequences are chained, 0 when fewer than two */
+{
+    uint32_t m = pb_cmask[t % NTRK], n = 0;
+    while (m) {
+        n += m & 1u;
+        m >>= 1;
+    }
+    return n > 1u ? n : 0u;
+}
+static int pb_chained(uint32_t t, uint32_t slot) { return slot < PB_N && ((pb_cmask[t % NTRK] >> slot) & 1u); }
+static void pb_chain_set(uint32_t t, uint32_t slot, int on)   /* chain (or not) sequence slot of track t */
+{
+    uint8_t m;
+    t %= NTRK;
+    pb_need();
+    if (slot >= PB_N)
+        return;
+    m = on ? (uint8_t)(pb_cmask[t] | 1u << slot) : (uint8_t)(pb_cmask[t] & ~(1u << slot));
+    if (m != pb_cmask[t]) {
+        pb_cmask[t] = m;
+        pb_dirty |= 1u << PB_META_O;
+        pb_gen++;
+    }
+}
+static int pb_chain_next(uint32_t t)                   /* the chained sequence after the one playing; -1: it is no chained one, or alone */
+{
+    uint32_t c = pb_cur[t % NTRK], i;
+    if (!pb_chain_count(t) || !pb_chained(t, c))
+        return -1;
+    for (i = 1; i < PB_N; i++)
+        if (pb_chained(t, (c + i) % PB_N))
+            return (int)((c + i) % PB_N);
+    return -1;
+}
+
+/* the sequence a knob step starts from: the one waiting (SEQ SWITCH END) if there is one, else the one playing. Stepping from
+ * the playing one made every step land on the same neighbour while a switch waited: a far sequence could not be reached */
+static uint32_t pb_target(uint32_t t)
+{
+    t %= NTRK;
+    return pb_next[t] ? (uint32_t)pb_next[t] - 1u : pb_cur[t];
+}
+
+/* a sequence chosen for track t (SEQ > SEQUENCE's knobs, SEQ held + C5..G5). MENU > CONTROL > SEQ SWITCH: NOW at once; END,
+ * while the music plays, at the end of the sequence playing (pb_due). 0 switched, 1 waits, 2 it is the one playing (a
+ * waiting switch is called off), < 0 pb_select's rc, negated */
+static int pb_request(uint32_t t, uint32_t s)
+{
+    int rc;
+    t %= NTRK;
+    pb_need();
+    if (s == pb_cur[t]) {
+        pb_next[t] = 0;
+        return 2;
+    }
+    if ((ui_prefs3 & (PREF_SEQ_END >> 24)) && song.playing && s < PB_N) {
+        pb_next[t] = (uint8_t)(s + 1u);
+        return 1;
+    }
+    rc = pb_select(t, s);
+    return rc ? -rc : 0;
+}
+/* main loop, every pass, per track: at the end of the sequence playing, a waiting switch (SEQ SWITCH END) or else the next
+ * sequence of the chain happens: on the last step (the next step is the new one's first), at once for a waiting one when
+ * the music is stopped, and late (a wrap seen) when a pass missed the last step. 1 switched, 0 nothing (yet), < 0
+ * pb_select's rc, negated (the switch is dropped) */
+static int pb_due(uint32_t t)
+{
+    const track_t *tr = &trk[t];
+    uint32_t idx = tr->seq_idx, run = song.playing && tr->seq_pos < 0x7FFFFFFFu, last = pb_last[t], at_end;
+    int rc, nx;
+    pb_last[t] = (uint8_t)idx;
+    if (!run)
+        pb_fired[t] = 0;                                /* (stopped: the next start is a new pass) */
+    if (pb_fired[t]) {                                  /* this boundary was handled: wait for the pass to be under way */
+        if (idx + 1u < (uint32_t)tr->p[P_SLEN])
+            pb_fired[t] = 0;
+        return 0;
+    }
+    at_end = run && (idx + 1u >= (uint32_t)tr->p[P_SLEN] || idx < last);
+    if (pb_next[t]) {
+        if (run && !at_end)
+            return 0;
+        rc = pb_select(t, (uint32_t)pb_next[t] - 1u);
+        pb_next[t] = 0;
+        pb_fired[t] = (uint8_t)run;
+        return rc ? -rc : 1;
+    }
+    nx = at_end ? pb_chain_next(t) : -1;
+    if (nx < 0)
+        return 0;
+    rc = pb_select(t, (uint32_t)nx);
+    pb_fired[t] = 1;
+    return rc ? -rc : 1;
+}
+
+/* the music was loaded (project.c project_restore_runtime): every track plays sequence 1 of an empty bank, the loaded
+ * steps and LEN in it. A store (patbank_store.c) fills the rest */
+static void pb_reset_to_live(void)
+{
+    uint32_t t;
+    pb_clear_all();
+    gen_defaults();                                      /* (the ARP's GEN knobs: the store's, if it has them, come after) */
+    cpk_defaults();                                      /* (CHRD PLAY's chord packs, the same) */
+    for (t = 0; t < NTRK; t++)
+        pb_sync(t);
+    pb_dirty = 0x3Fu;
+    pb_gen++;
+}
+
+/* ---- SAVE > CHORDS (chord.c): the pack the black keys follow, edited and kept ---- */
+static void cpk_touch(void)                             /* the packs changed: saved with the music (patbank_store.c) */
+{
+    pb_dirty |= 1u << PB_META_O;
+    pb_gen++;
+}
+/* SAVE > CHORDS: KNOB 1 the pack (it is loaded at once), 2 the black key, 3 its action, 4 the strum speed */
+static void cpk_edit(uint32_t slot, int32_t steps)
+{
+    if (slot == 0u) {
+        cpk_sel = (uint8_t)clamp((int32_t)cpk_sel + steps, 0, (int32_t)CPK_N - 1);
+        cpk = *cpk_pack(cpk_sel);
+    } else if (slot == 1u)
+        cpk_key = (uint8_t)clamp((int32_t)cpk_key + steps, 0, (int32_t)CPK_KEYS - 1);
+    else if (slot == 2u)
+        cpk.act[cpk_key] = (uint8_t)clamp((int32_t)cpk.act[cpk_key] + steps, 0, (int32_t)CA_N - 1);
+    else
+        cpk.strum = (uint8_t)clamp((int32_t)cpk.strum + steps, 0, (int32_t)CPK_STRUM_MAX);
+    cpk_touch();
+    ui.force = 1;
+}
+/* OCT+: what the black keys do now, kept as the user's pack picked (a built in one is not written over) */
+static void cpk_save(void)
+{
+    char nb[8], mb[16] = "SAVED ";
+    if (cpk_sel < CPK_NF) {
+        ui_message("PICK A USER PACK");
+        return;
+    }
+    cpk_user[cpk_sel - CPK_NF] = cpk;
+    str_cpy(mb + 6, cpk_name(cpk_sel, nb), 9);
+    ui_message(mb);
+    cpk_touch();
+}
+#else
+#define pb_gen 0u
+#endif
diff --git a/firmware/src/patbank_store.c b/firmware/src/patbank_store.c
new file mode 100644
index 0000000..c48a986
--- /dev/null
+++ b/firmware/src/patbank_store.c
@@ -0,0 +1,237 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments */
+/* The sequence banks in flash (patbank.c): store s (0..3 the projects A..D, PB_LIVE the music as it is now), six objects
+ * OBJ_PB0 + 6 s + o, each an A/B pair of storage.c. Payload: 8 bytes {'P', 'B', 1, o, 0 x 4}, then (objects 0..2 are version 2 since
+ * the ARP's GEN: their last four bytes are GEN's DENS, CHORD, EVOLVE of the four tracks; the meta object: the chained masks there)
+ *   o < 5   six sequences (576 bytes each), 3464 bytes
+ *   o = 5   the last two sequences, the sequence each track plays (4), the 32 LENs, per sequence its automation record
+ *           count and ON (2 bytes), then the records of the sequences with some (3 bytes each, in order); the playing
+ *           sequence's are in the project record, not here. At most PB_META_RECS of them: more is refused (pb_meta_ok) */
+#if FELUCCA_PATBANK && FELUCCA_FLASH
+#define PB_META_FIX (PB_HDR + 2u * PB_PAT_B + NTRK + PB_NSEQ + 2u * PB_NSEQ)
+#define PB_CPK_B ((1u + CPK_USER) * (uint32_t)sizeof(cpack_t))   /* the chord packs (chord.c), version 3, after the records */
+#define PB_META_RECS ((PB_OBJ_MAX - PB_META_FIX - PB_CPK_B) / 3u)
+/* The object's RAM is the project staging RAM (project.c proj_wire_u): a save, a load and the autosave already take turns with
+ * it, and a backup noticing proj_wire_gen knows it was reused. It is not kept a 3.8 KB buffer of its own: the pool is full */
+#define pb_wire (proj_wire_u.raw)
+_Static_assert(sizeof proj_wire_u.raw >= PB_OBJ_MAX, "the sequence bank objects fit the project staging RAM");
+#define PB_WIRE_USE() (proj_wire_gen++)
+
+static uint32_t pb_obj_pats(uint32_t o) { return o < PB_META_O ? PB_PER : PB_NSEQ - PB_PER * PB_META_O; }
+static uint32_t pb_records(void)            /* automation records the mirror holds outside the playing sequences */
+{
+    uint32_t t, n = 0;
+    for (t = 0; t < PB_NSEQ; t++)
+        if (t % PB_N != pb_cur[t / PB_N])
+            n += pb_mo[t].count;
+    return n;
+}
+static int pb_meta_ok(void) { return pb_records() <= PB_META_RECS; }
+
+/* object o -> pb_wire; its length */
+static uint32_t pb_build(uint32_t o)
+{
+    PB_WIRE_USE();
+    uint32_t n = pb_obj_pats(o), pos = PB_HDR, q;
+    memset(pb_wire, 0, PB_HDR);
+    pb_wire[0] = 'P'; pb_wire[1] = 'B'; pb_wire[2] = 1; pb_wire[3] = (uint8_t)o;
+    if (o < GS_N) {                                     /* GEN (version 2): the objects 0..2 carry DENS, CHORD, EVOLVE */
+        pb_wire[2] = 2;
+        for (q = 0; q < NTRK; q++)
+            pb_wire[4u + q] = gen_set[q][o];
+    }
+    if (o == PB_META_O) {                               /* CHAIN: per track the mask of the chained sequences (version 2); 3: the chord packs */
+        pb_wire[2] = 3;
+        for (q = 0; q < NTRK; q++)
+            pb_wire[4u + q] = pb_cmask[q];
+    }
+    memcpy(pb_wire + pos, pb_pat[o * PB_PER], n * PB_PAT_B);
+    pos += n * PB_PAT_B;
+    if (o == PB_META_O) {
+        memcpy(pb_wire + pos, pb_cur, NTRK); pos += NTRK;
+        memcpy(pb_wire + pos, pb_len, PB_NSEQ); pos += PB_NSEQ;
+        for (q = 0; q < PB_NSEQ; q++) {
+            int on = q % PB_N != pb_cur[q / PB_N];
+            pb_wire[pos++] = on ? pb_mo[q].count : 0;
+            pb_wire[pos++] = on ? pb_mo[q].on : 0;
+        }
+        for (q = 0; q < PB_NSEQ; q++)
+            if (q % PB_N != pb_cur[q / PB_N]) {
+                memcpy(pb_wire + pos, pb_mo[q].ev, pb_mo[q].count * sizeof(motion_event_t));
+                pos += pb_mo[q].count * (uint32_t)sizeof(motion_event_t);
+            }
+        memcpy(pb_wire + pos, &cpk, sizeof cpk); pos += (uint32_t)sizeof cpk;           /* the chord packs: what the black keys do, the user's */
+        for (q = 0; q < CPK_USER; q++) {
+            memcpy(pb_wire + pos, &cpk_user[q], sizeof(cpack_t));
+            pos += (uint32_t)sizeof(cpack_t);
+        }
+    }
+    return pos;
+}
+
+/* the objects of `mask` of store s -> flash; 0 ok. Syncs the playing sequences first */
+static int pb_store_save(uint32_t s, uint32_t mask)
+{
+    uint32_t o;
+    pb_need();
+    pb_sync_all();
+    if (!pb_meta_ok())
+        return 3;
+    for (o = 0; o < PB_NOBJ; o++)
+        if ((mask >> o) & 1u) {
+            uint32_t n = pb_build(o);
+            if (st_save(OBJ_PB0 + s * PB_NOBJ + o, pb_wire, n))
+                return 2;
+        }
+    return 0;
+}
+
+/* store s -> the mirror, after the music (steps, LEN, automation: the playing sequences) was loaded; 0: no such store
+ * (the mirror holds just the loaded music, pb_reset_to_live) */
+static int pb_store_load(uint32_t s)
+{
+    PB_WIRE_USE();
+    uint32_t o, q, t, pos, n;
+    uint8_t cur[NTRK], len[PB_NSEQ], cnt[PB_NSEQ], on[PB_NSEQ];
+    pb_reset_to_live();
+    n = (uint32_t)st_load(OBJ_PB0 + s * PB_NOBJ + PB_META_O, pb_wire, sizeof pb_wire);
+    if ((int)n < 0 || n < PB_META_FIX || pb_wire[0] != 'P' || pb_wire[1] != 'B' || (pb_wire[2] < 1 || pb_wire[2] > 3) || pb_wire[3] != PB_META_O)
+        return 0;
+    pos = PB_HDR + 2u * PB_PAT_B;
+    memcpy(cur, pb_wire + pos, NTRK); pos += NTRK;
+    memcpy(len, pb_wire + pos, PB_NSEQ); pos += PB_NSEQ;
+    for (q = 0; q < PB_NSEQ; q++) {
+        cnt[q] = pb_wire[pos++];
+        on[q] = pb_wire[pos++];
+    }
+    for (t = 0; t < NTRK; t++)
+        if (cur[t] >= PB_N)
+            return 0;
+    {   /* the records, checked against the length before any of it is kept */
+        uint32_t tot = 0;
+        for (q = 0; q < PB_NSEQ; q++) {
+            if (cnt[q] > PB_MO_MAX) return 0;
+            tot += cnt[q];
+        }
+        if (pos + tot * sizeof(motion_event_t) > n) return 0;
+    }
+    memcpy(pb_pat[PB_META_O * PB_PER], pb_wire + PB_HDR, 2u * PB_PAT_B);
+    for (t = 0; t < NTRK; t++)                          /* CHAIN: version 2 has the masks (version 1: a start and a length: none) */
+        pb_cmask[t] = pb_wire[2] >= 2 ? pb_wire[4u + t] : 0u;
+    for (q = 0; q < PB_NSEQ; q++) {
+        uint32_t k;
+        pb_mo[q].count = 0;
+        if (!cnt[q])
+            continue;
+        pb_mo[q].on = on[q] != 0u;
+        for (k = 0; k < cnt[q]; k++, pos += sizeof(motion_event_t))
+            memcpy(&pb_mo[q].ev[k], pb_wire + pos, sizeof(motion_event_t));
+        pb_mo[q].count = cnt[q];
+    }
+    if (pb_wire[2] == 3 && pos + PB_CPK_B <= n) {       /* the chord packs (version 3; an earlier one: the built in ones pb_reset_to_live set) */
+        cpack_t pk[1u + CPK_USER];
+        uint32_t ok = 1;
+        memcpy(pk, pb_wire + pos, sizeof pk);
+        for (q = 0; q < 1u + CPK_USER; q++)
+            ok &= (uint32_t)cpk_valid(&pk[q]);
+        if (ok) {
+            cpk = pk[0];
+            for (q = 0; q < CPK_USER; q++)
+                cpk_user[q] = pk[1u + q];
+        }
+    }
+    for (q = 0; q < PB_NSEQ; q++)
+        pb_len[q] = len[q] >= (uint32_t)TP[P_SLEN].min && len[q] <= (uint32_t)TP[P_SLEN].max ? len[q] : (uint8_t)TP[P_SLEN].def;
+    for (o = 0; o < PB_META_O; o++) {
+        n = (uint32_t)st_load(OBJ_PB0 + s * PB_NOBJ + o, pb_wire, sizeof pb_wire);
+        if ((int)n == (int)(PB_HDR + PB_PER * PB_PAT_B) && pb_wire[0] == 'P' && pb_wire[1] == 'B' &&
+            (pb_wire[2] == 1 || pb_wire[2] == 2) && pb_wire[3] == o) {
+            memcpy(pb_pat[o * PB_PER], pb_wire + PB_HDR, PB_PER * PB_PAT_B);
+            if (o < GS_N && pb_wire[2] == 2)             /* GEN's knobs (1: stored before it: the defaults pb_reset_to_live set) */
+                for (t = 0; t < NTRK; t++)
+                    gen_set[t][o] = pb_wire[4u + t] < 128u ? pb_wire[4u + t] : gen_set[t][o];
+        }
+    }
+    for (t = 0; t < NTRK; t++) {            /* the sequence a track plays is the loaded music's (the record) */
+        pb_cur[t] = cur[t];
+        pb_mo[t * PB_N + cur[t]].count = 0;
+        pb_sync(t);
+    }
+    pb_dirty = 0x3Fu;
+    pb_gen++;
+    return 1;
+}
+
+
+/* A song (song_chain.c, project.c chain_prepare) plays other projects' sequences: store s's sequence the project was saved on
+ * for each track (its record plays that one); 0 when there is no such store (the record's is "sequence 1") */
+static int pb_store_saved(uint32_t s, uint8_t *cur)
+{
+    PB_WIRE_USE();
+    uint32_t n, t;
+    memset(cur, 0, NTRK);
+    n = (uint32_t)st_load(OBJ_PB0 + s * PB_NOBJ + PB_META_O, pb_wire, sizeof pb_wire);
+    if ((int)n < 0 || n < PB_META_FIX || pb_wire[0] != 'P' || pb_wire[1] != 'B' || (pb_wire[2] < 1 || pb_wire[2] > 3) || pb_wire[3] != PB_META_O)
+        return 0;
+    for (t = 0; t < NTRK; t++)
+        cur[t] = pb_wire[PB_HDR + 2u * PB_PAT_B + t] < PB_N ? pb_wire[PB_HDR + 2u * PB_PAT_B + t] : 0u;
+    return 1;
+}
+/* store s's sequence q of track k, for a song: its steps (st, NSTEP), LEN and automation (mo: the track's records). 0 done;
+ * 1 no such store or object (the sequence is empty, LEN the default) */
+static int pb_store_fetch(uint32_t s, uint32_t k, uint32_t q, step_t *st, uint8_t *len, pb_mo_t *mo)
+{
+    PB_WIRE_USE();
+    uint32_t n, qi = k * PB_N + q, pos, o, i, skip = 0, cnt;
+    uint8_t cur[NTRK];
+    for (i = 0; i < NSTEP; i++)
+        step_clear(&st[i]);
+    *len = (uint8_t)TP[P_SLEN].def;
+    memset(mo, 0, sizeof *mo);
+    n = (uint32_t)st_load(OBJ_PB0 + s * PB_NOBJ + PB_META_O, pb_wire, sizeof pb_wire);
+    if ((int)n < 0 || n < PB_META_FIX || pb_wire[0] != 'P' || pb_wire[1] != 'B' || (pb_wire[2] < 1 || pb_wire[2] > 3) || pb_wire[3] != PB_META_O)
+        return 1;
+    (void)cur;
+    pos = PB_HDR + 2u * PB_PAT_B + NTRK;
+    if (pb_wire[pos + qi] >= (uint32_t)TP[P_SLEN].min && pb_wire[pos + qi] <= (uint32_t)TP[P_SLEN].max)
+        *len = pb_wire[pos + qi];
+    pos += PB_NSEQ;                                      /* the (count, ON) pairs, then the records of those with some */
+    for (i = 0; i < qi; i++)
+        skip += pb_wire[pos + 2u * i];
+    cnt = pb_wire[pos + 2u * qi];
+    if (cnt && cnt <= PB_MO_MAX && pos + 2u * PB_NSEQ + (skip + cnt) * sizeof(motion_event_t) <= n) {
+        memcpy(mo->ev, pb_wire + pos + 2u * PB_NSEQ + skip * sizeof(motion_event_t), cnt * sizeof(motion_event_t));
+        mo->count = (uint8_t)cnt;
+        mo->on = pb_wire[pos + 2u * qi + 1u] != 0u;
+    }
+    if (qi >= PB_META_O * PB_PER) {                      /* the last two sequences are in the meta object itself */
+        /* (pb_wire holds it: read in place) */
+        if (n >= PB_HDR + (qi - PB_META_O * PB_PER + 1u) * PB_PAT_B)
+            (void)pb_unpack_pat(st, pb_wire + PB_HDR + (qi - PB_META_O * PB_PER) * PB_PAT_B);
+        return 0;
+    }
+    o = qi / PB_PER;
+    n = (uint32_t)st_load(OBJ_PB0 + s * PB_NOBJ + o, pb_wire, sizeof pb_wire);
+    if ((int)n == (int)(PB_HDR + PB_PER * PB_PAT_B) && pb_wire[0] == 'P' && pb_wire[1] == 'B' &&
+        (pb_wire[2] == 1 || pb_wire[2] == 2) && pb_wire[3] == o)
+        (void)pb_unpack_pat(st, pb_wire + PB_HDR + (qi % PB_PER) * PB_PAT_B);
+    return 0;
+}
+
+/* the autosave's companion (project.c autosave_poll): the live store, the objects that changed; 0 ok */
+static int pb_flush_live(void)
+{
+    uint32_t o, m;
+    pb_sync_all();
+    m = pb_dirty;
+    if (!m)
+        return 0;
+    for (o = 0; o < PB_NOBJ; o++)
+        if ((m >> o) & 1u) {
+            if (pb_store_save(PB_LIVE, 1u << o))
+                return 1;
+            pb_dirty &= (uint8_t)~(1u << o);
+        }
+    return 0;
+}
+#endif
diff --git a/firmware/src/project.c b/firmware/src/project.c
index c972d6e..290bce1 100644
--- a/firmware/src/project.c
+++ b/firmware/src/project.c
@@ -483,6 +483,14 @@ static void proj_fm6_init(project_t *q)
         memcpy(q->fm6[t], FM6_INIT, FM6_PACKED);
     q->sum = proj_sum(q);
 }
+#if FELUCCA_PATBANK && FELUCCA_FLASH
+/* the sequence banks (patbank_store.c, included after this file: its object RAM is proj_wire) */
+static int pb_store_save(uint32_t s, uint32_t mask);
+static int pb_store_load(uint32_t s);
